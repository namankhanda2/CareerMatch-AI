# Copy this file to backend/.env and fill in your values.
#   cp .env.example backend/.env

# Required: Groq API key used to analyze the resume against the job description.
GROQ_API_KEY=gsk_your-groq-api-key

# Optional: Groq model name (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: backend CORS origins (comma-separated). Defaults cover local Vite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
